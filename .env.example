# Copy to .env and fill from Supabase -> Project Settings -> API.
# Both values are safe in the browser: the anon key only ever gets you what
# RLS allows. Never put the service_role key in this file -- if something
# genuinely needs it, that work belongs in an Edge Function.
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Local authoring only — used by the import scripts, never by the app.
# The service role key bypasses RLS entirely. It must never appear in any
# PUBLIC_ variable, any committed file, or anything sent to the browser.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
